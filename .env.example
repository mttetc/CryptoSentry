# Copy to .env and fill in. Never commit .env.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WAITLIST_MODE=false

# Supabase (Postgres + PostgREST). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Better Auth (tables created with `npx @better-auth/cli migrate` BEFORE supabase migrations)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) filtered stream, official API, pay-per-use.
# App-only Bearer token from console.x.com. Billed ~$0.005 per delivered post.
X_BEARER_TOKEN=
# Hard monthly cap on posts delivered by the stream (global, all users). 20000 posts ~= $100.
X_STREAM_MONTHLY_POST_CAP=20000
# Leave at most this many rules on the project (X pay-per-use limit is 1000).
X_STREAM_MAX_RULES=900

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourBotUsername
# Secret sent by Telegram in the x-telegram-bot-api-secret-token header (see scripts/setup-telegram-webhook.ts)
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
# Signs the QR connect links (defaults to BETTER_AUTH_SECRET when unset)
TELEGRAM_CONNECT_SECRET=

# Optional providers
OPENAI_API_KEY=
RESEND_API_KEY=
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
